{
  "manifest_version": 3,
  "name": "Custom Bookmark Sidebar",
  "version": "1.0",
  "description": "ページ左端に固定表示されるカスタムブックマークサイドバー",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "Bookmark Sidebar をトグル"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils.js", "sidebar.js"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "open-bookmark-1": {
      "suggested_key": { "default": "Ctrl+Shift+A" },
      "description": "ブックマーク1番目を開く"
    },
    "open-bookmark-2": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "ブックマーク2番目を開く"
    },
    "open-bookmark-3": {
      "suggested_key": { "default": "Ctrl+Shift+D" },
      "description": "ブックマーク3番目を開く"
    },
    "open-bookmark-4": {
      "suggested_key": { "default": "Ctrl+Shift+F" },
      "description": "ブックマーク4番目を開く"
    },
    "open-bookmark-5": {
      "description": "ブックマーク5番目を開く（chrome://extensions/shortcuts で手動設定）"
    }
  }
}