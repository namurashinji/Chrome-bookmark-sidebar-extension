{
  "manifest_version": 3,
  "name": "Custom Bookmark Sidebar",
  "version": "2.0",
  "description": "サイドパネルに表示するカスタムブックマーク。ショートカットで即座に開ける",
  "minimum_chrome_version": "141",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "Bookmark Sidebar を開閉"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "toggle-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+A", "mac": "MacCtrl+Shift+A" },
      "description": "サイドパネルを開閉"
    },
    "open-bookmark-1": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+Z" },
      "description": "ブックマーク1番目を開く"
    },
    "open-bookmark-2": {
      "suggested_key": { "default": "Ctrl+Shift+D", "mac": "MacCtrl+Shift+X" },
      "description": "ブックマーク2番目を開く"
    },
    "open-bookmark-3": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+C" },
      "description": "ブックマーク3番目を開く"
    },
    "open-bookmark-4": {
      "description": "ブックマーク4番目を開く（chrome://extensions/shortcuts で手動設定。推奨: Mac は Control+Shift+V）"
    },
    "open-bookmark-5": {
      "description": "ブックマーク5番目を開く（chrome://extensions/shortcuts で手動設定。推奨: Mac は Control+Shift+B）"
    }
  }
}
